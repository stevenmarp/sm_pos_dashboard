<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sm_pos_dashboard.Dashboard">
        <div class="sm-dash h-100 overflow-auto p-3">
            <t t-if="state.data">
                <div class="d-flex align-items-baseline mb-3">
                    <h2 class="mb-0 me-2">POS Live Dashboard</h2>
                    <span class="text-muted" t-esc="state.data.date"/>
                    <span class="sm-dash-live ms-3">LIVE</span>
                </div>

                <div class="sm-dash-tiles mb-4">
                    <div class="sm-dash-tile">
                        <div class="sm-dash-tile-label">Revenue Today</div>
                        <div class="sm-dash-tile-value" t-esc="fmt(state.data.revenue)"/>
                    </div>
                    <div class="sm-dash-tile">
                        <div class="sm-dash-tile-label">Orders</div>
                        <div class="sm-dash-tile-value" t-esc="state.data.orders"/>
                    </div>
                    <div class="sm-dash-tile">
                        <div class="sm-dash-tile-label">Average Ticket</div>
                        <div class="sm-dash-tile-value" t-esc="fmt(state.data.avg_ticket)"/>
                    </div>
                    <div class="sm-dash-tile">
                        <div class="sm-dash-tile-label">Open Sessions</div>
                        <div class="sm-dash-tile-value" t-esc="state.data.open_sessions"/>
                    </div>
                </div>

                <div class="sm-dash-card mb-4">
                    <div class="sm-dash-card-title">Hourly Revenue</div>
                    <div class="sm-dash-chart">
                        <t t-foreach="state.data.hourly" t-as="value" t-key="value_index">
                            <div class="sm-dash-col" t-att-title="value_index + ':00 - ' + fmt(value)">
                                <span t-if="value_index === maxHourIndex and value gt 0"
                                      class="sm-dash-col-label" t-esc="fmt(value)"/>
                                <div class="sm-dash-bar"
                                     t-attf-style="height: {{ Math.max(value / maxHourly * 140, value gt 0 ? 3 : 0) }}px"/>
                                <div class="sm-dash-col-hour" t-esc="value_index"/>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="sm-dash-grid">
                    <div class="sm-dash-card">
                        <div class="sm-dash-card-title">Per Point of Sale</div>
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>POS</th>
                                    <th class="text-end">Orders</th>
                                    <th class="text-end">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.data.per_config" t-as="cfg" t-key="cfg.name">
                                    <td t-esc="cfg.name"/>
                                    <td class="text-end" t-esc="cfg.orders"/>
                                    <td class="text-end" t-esc="fmt(cfg.revenue)"/>
                                </tr>
                                <tr t-if="!state.data.per_config.length">
                                    <td colspan="3" class="text-muted">No sales yet today</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="sm-dash-card">
                        <div class="sm-dash-card-title">Top Products</div>
                        <div t-foreach="state.data.top_products" t-as="product" t-key="product.name"
                             class="sm-dash-row" t-att-title="fmt(product.revenue)">
                            <div class="sm-dash-row-head">
                                <span class="text-truncate" t-esc="product.name"/>
                                <span class="text-muted ms-2" t-esc="product.qty"/>
                            </div>
                            <div class="sm-dash-row-track">
                                <div class="sm-dash-row-fill"
                                     t-attf-style="width: {{ product.revenue / maxProductRevenue * 100 }}%"/>
                            </div>
                        </div>
                        <div t-if="!state.data.top_products.length" class="text-muted">No sales yet today</div>
                    </div>

                    <div class="sm-dash-card">
                        <div class="sm-dash-card-title">Payment Methods</div>
                        <div t-foreach="state.data.payments" t-as="pm" t-key="pm.name"
                             class="sm-dash-row" t-att-title="fmt(pm.amount)">
                            <div class="sm-dash-row-head">
                                <span t-esc="pm.name"/>
                                <span class="text-muted ms-2" t-esc="fmt(pm.amount)"/>
                            </div>
                            <div class="sm-dash-row-track">
                                <div class="sm-dash-row-fill"
                                     t-attf-style="width: {{ pm.amount / totalPayments * 100 }}%"/>
                            </div>
                        </div>
                        <div t-if="!state.data.payments.length" class="text-muted">No payments yet today</div>
                    </div>

                    <div class="sm-dash-card">
                        <div class="sm-dash-card-title">Recent Orders</div>
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr t-foreach="state.data.recent" t-as="order" t-key="order_index">
                                    <td class="text-muted" t-esc="order.time"/>
                                    <td t-esc="order.config"/>
                                    <td class="text-end" t-esc="fmt(order.amount)"/>
                                </tr>
                                <tr t-if="!state.data.recent.length">
                                    <td class="text-muted">No orders yet today</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
